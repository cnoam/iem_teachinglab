# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.lock.hcl

# Deployment-specific vars (subscription id, per-semester config) — commit the .example instead
*.tfvars
!*.tfvars.example

# Admin SSH key (TF-generated — keep only in TF state, not in git)
id_rsa_lab.pem
id_rsa_lab.pub

# Generated by Terraform
inventory.ini
ansible.cfg

# Student deploy keys — drop .pub files here, never commit them
keys/*.pub
